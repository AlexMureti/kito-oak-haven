# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photo-pipeline scratch (proof sheets, probes, screenshots) — regenerable
/scripts/_mask
/scripts/_shots

# remotion
/remotion/node_modules
/remotion/out

# Camera originals — 194MB of source JPEGs. The build pipeline reads these
# locally; only the derivatives in public/gallery ever ship.
/scripts/_originals/
/scripts/_shots/
/scripts/_mask/
